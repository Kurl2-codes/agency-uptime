{
    "mcpServers": {
        "uptime-kuma": {
            "command": "npx",
            "args": [
                "-y",
                "@davidfuchs/mcp-uptime-kuma"
            ],
            "env": {
                "UPTIME_KUMA_URL": "http://uptime-kuma:3001",
                "UPTIME_KUMA_USERNAME": "your_username",
                "UPTIME_KUMA_PASSWORD": "your_password"
            }
        }
    }
}